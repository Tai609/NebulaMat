{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NebulaMat",
  "mainBinaryName": "NebulaMat",
  "version": "1.10.0",
  "identifier": "com.ai4s.workbench",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter @ai4s/desktop exec vite --port 5173 --strictPort",
    "beforeBuildCommand": "pnpm --filter @ai4s/desktop build"
  },
  "app": {
    "windows": [
      {
        "title": "NebulaMat",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 640,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "zoomHotkeysEnabled": false,
        "trafficLightPosition": {
          "x": 13,
          "y": 22
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/uv",
      "binaries/agent-browser"
    ],
    "macOS": {
      "hardenedRuntime": true,
      "infoPlist": "./Info.plist",
      "minimumSystemVersion": "13.0"
    },
    "resources": {
      "../../../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../../../runtime/skills-bundle": "skills/",
      "../../../runtime/aicc": "aicc/",
      "../../../runtime/aris": "aris/",
      "../../../runtime/harness": "harness/",
      "../../../runtime/materials-mcp": "materials-mcp/",
      "../../../runtime/paper-search-mcp": "paper-search-mcp/",
      "../../../runtime/mattergen/upstream": "mattergen/upstream/",
      "../../../runtime/mattergen/mattergen_runner.py": "mattergen/mattergen_runner.py",
      "../../../runtime/mattergen/setup_mattergen.py": "mattergen/setup_mattergen.py",
      "../../../runtime/mattersim": "mattersim/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  }
}
