{
  "schema_version": 1,
  "capabilities": [
    {
      "id": "literature.search",
      "owner": "literature",
      "executor": "agent",
      "tool": "search_materials",
      "inputs": ["query", "providers", "constraints"],
      "outputs": ["material_records", "source_links", "uncertainty"],
      "risk": "low",
      "cost": "network",
      "parallelizable": true,
      "summary": "Search and normalize literature or database evidence without treating missing records as negative evidence."
    },
    {
      "id": "materials.discover.database",
      "owner": "materials",
      "executor": "mcp",
      "tool": "search_materials",
      "inputs": ["query", "providers", "limit"],
      "outputs": ["normalized_material_records", "provider_status", "source_links", "uncertainty"],
      "risk": "low",
      "cost": "network",
      "parallelizable": true,
      "summary": "Search Materials Project, OQMD, and NOMAD for reference structures and thermodynamic records; provider gaps remain explicit.",
      "providers": ["materials_project", "oqmd", "nomad"]
    },
    {
      "id": "structure.generate.mattergen",
      "owner": "materials",
      "executor": "mattergen",
      "tool": "NEBULAMAT_MATTERGEN_RUNNER",
      "inputs": ["chemical_system", "constraints", "samples", "model"],
      "outputs": ["cif_structures", "generation_manifest", "structure_hashes"],
      "risk": "medium",
      "cost": "gpu",
      "parallelizable": true,
      "summary": "Generate candidate crystal structures; generation is not stability or synthesizability evidence."
    },
    {
      "id": "structure.edit.ase",
      "owner": "materials",
      "executor": "agent",
      "tool": "ase",
      "inputs": ["structure", "operations"],
      "outputs": ["edited_structure", "edit_manifest", "structure_hash"],
      "risk": "low",
      "cost": "cpu",
      "parallelizable": true,
      "summary": "Apply explicit ASE structure edits such as supercells, substitutions, defects, adsorbate placement, or constraints."
    },
    {
      "id": "structure.standardize.mattergen",
      "owner": "materials",
      "executor": "mcp",
      "tool": "standardize_mattergen_structure",
      "inputs": ["raw_cif", "bulk_target_atoms", "surface_miller_index", "surface_layers", "surface_target_atoms", "vacuum_angstrom", "surface_min_lateral_angstrom", "surface_max_cell_aspect_ratio"],
      "outputs": ["standardized_bulk", "standardized_surface", "standardization_manifest", "structure_hashes"],
      "risk": "medium",
      "cost": "cpu",
      "parallelizable": true,
      "summary": "Expand MatterGen primitive cells into a comparable bulk/surface size window with exact real atomic-plane counts, total vacuum, bounded cell aspect ratio, and hash-bearing provenance before relaxation or adsorption screening."
    },
    {
      "id": "structure.validate",
      "owner": "materials",
      "executor": "mcp",
      "tool": "validate_structure_file",
      "inputs": ["structure_path", "min_distance"],
      "outputs": ["validation_report", "structure_hash"],
      "risk": "low",
      "cost": "cpu",
      "parallelizable": true,
      "summary": "Run deterministic structure and geometry checks before expensive models."
    },
    {
      "id": "thermo.analyze.pymatgen",
      "owner": "materials",
      "executor": "agent",
      "tool": "pymatgen",
      "inputs": ["standardized_structures", "reference_records", "chemical_potentials", "pH_range"],
      "outputs": ["formation_energy_or_hull", "phase_stability", "pourbaix_window", "thermo_uncertainty"],
      "risk": "medium",
      "cost": "cpu",
      "parallelizable": true,
      "summary": "Use pymatgen for structure normalization, phase-stability interpretation, and Pourbaix screening; database-derived stability is not experimental synthesizability."
    },
    {
      "id": "alloy.sample.smol",
      "owner": "materials",
      "executor": "agent",
      "tool": "smol",
      "inputs": ["validated_structure", "existing_cluster_expansion", "composition_grid", "samples"],
      "outputs": ["ordered_or_disordered_configurations", "sampling_manifest", "configuration_uncertainty"],
      "risk": "medium",
      "cost": "cpu",
      "parallelizable": true,
      "optional": true,
      "skip_when": "existing_cluster_expansion_missing",
      "summary": "Sample alloy or disorder configurations only from an existing compatible cluster expansion; never fit a new expansion inside this workflow, and record a skip when none is available."
    },
    {
      "id": "surface.construct",
      "owner": "materials",
      "executor": "mcp",
      "tool": "compile_material_candidate_structure",
      "inputs": ["candidate", "structure_spec", "surface_specs", "interface_specs"],
      "outputs": ["slab_files", "interface_files", "structure_manifest"],
      "risk": "medium",
      "cost": "cpu",
      "parallelizable": true,
      "summary": "Construct explicit slabs, interfaces, and adsorption-ready structures from a validated candidate."
    },
    {
      "id": "surface.construct.catkit",
      "owner": "materials",
      "executor": "agent",
      "tool": "CatKit+ASE+pymatgen",
      "inputs": ["bulk_or_configuration", "miller_indices", "terminations", "adsorbates", "site_policy"],
      "outputs": ["slabs", "surface_terminations", "adsorption_sites", "adsorption_structure_set", "surface_manifest"],
      "risk": "medium",
      "cost": "cpu",
      "parallelizable": true,
      "summary": "Generate periodic facets, terminations, and explicit adsorption sites with CatKit, ASE, and pymatgen; preserve cell, termination, and site provenance."
    },
    {
      "id": "structure.standardize.adsorption",
      "owner": "materials",
      "executor": "mcp",
      "tool": "standardize_uma_adsorption_structure_set",
      "inputs": ["standardized_slab_path", "adsorbate_path", "adsorbed_path", "output_dir"],
      "outputs": ["normalized_adsorption_structures", "standardization_manifest", "cohort_checks", "structure_hashes"],
      "risk": "medium",
      "cost": "cpu",
      "parallelizable": true,
      "summary": "Validate an explicitly supplied adsorption triplet for cell, atom-count, and composition consistency before UMA; no adsorbate is invented or placed."
    },
    {
      "id": "stability.screen.mattersim",
      "owner": "materials",
      "executor": "mcp",
      "tool": "run_mattersim_stability_screen",
      "inputs": ["structure_path", "structure_kind", "relax", "relax_cell", "device"],
      "outputs": ["relaxed_structure", "energy_force_stress", "stability_proxy", "checkpoint_sha256"],
      "risk": "medium",
      "cost": "gpu",
      "parallelizable": true,
      "summary": "Use MatterSim-v1.0.0-5M for a relaxation and stability proxy; slab results require VASP calibration."
    },
    {
      "id": "adsorption.screen.uma",
      "owner": "materials",
      "executor": "mcp",
      "tool": "run_uma_adsorption_energy_screen",
      "inputs": ["slab_path", "adsorbate_path", "adsorbed_path", "model_name", "task_name", "device", "relax", "fixed_bottom_layers"],
      "outputs": ["relaxed_structures", "relaxation_status", "adsorption_energy", "component_energies", "input_hashes", "uncertainty"],
      "risk": "medium",
      "cost": "gpu",
      "parallelizable": true,
      "summary": "Relax the slab, isolated adsorbate, and adsorbed slab with one UMA protocol, then evaluate adsorption energy only when all three converge."
    },
    {
      "id": "adsorption.evidence.retrieve",
      "owner": "literature",
      "executor": "agent",
      "tool": "Catalysis-Hub+OC20+OC22+OC25+literature",
      "inputs": ["reaction", "adsorbates", "surface_family", "providers", "query_scope"],
      "outputs": ["adsorption_energies", "reaction_energies", "bep_parameters", "scaling_relations", "source_provenance", "evidence_gaps"],
      "risk": "medium",
      "cost": "network",
      "parallelizable": true,
      "summary": "Collect adsorption, reaction, BEP, and scaling evidence from Catalysis-Hub, OC20/OC22/OC25, and literature with source-level uncertainty; labels are not silently treated as comparable."
    },
    {
      "id": "kinetics.complete.scaling_bep",
      "owner": "materials",
      "executor": "agent",
      "tool": "scaling+BEP",
      "inputs": ["adsorption_energies", "reaction_energies", "scaling_parameters", "bep_parameters", "reference_state"],
      "outputs": ["intermediate_free_energies", "transition_state_barriers", "parameter_uncertainty", "descriptor_gaps"],
      "risk": "medium",
      "cost": "model",
      "parallelizable": true,
      "summary": "Complete missing intermediate free energies and transition-state barriers through declared scaling and BEP relations; extrapolation remains a model assumption."
    },
    {
      "id": "microkinetics.screen.catmap",
      "owner": "materials",
      "executor": "agent",
      "tool": "CatMAP",
      "inputs": ["reaction_network", "free_energies", "barriers", "pH_range", "potential_range", "field_range", "coverage_model"],
      "outputs": ["rate_map", "selectivity_map", "rate_limiting_steps", "sensitivity", "microkinetic_uncertainty"],
      "risk": "medium",
      "cost": "cpu",
      "parallelizable": true,
      "summary": "Run CatMAP microkinetics over pH, potential, and field conditions using explicit thermochemistry and barriers; report unsupported regions rather than filling them silently."
    },
    {
      "id": "reactor.validate.cantera",
      "owner": "materials",
      "executor": "agent",
      "tool": "Cantera/OpenMKM",
      "inputs": ["microkinetic_mechanism", "temperature_range", "pressure_range", "flow_conditions", "reactor_type"],
      "outputs": ["reactor_response", "conversion_selectivity", "transport_sensitivity", "reactor_validation_report"],
      "risk": "medium",
      "cost": "cpu",
      "optional": true,
      "alternatives": ["cantera", "openmkm"],
      "summary": "Validate the selected mechanism under reactor temperature, pressure, and flow conditions with Cantera or OpenMKM; reactor results do not replace surface-level evidence."
    },
    {
      "id": "spatial.refine.kmos",
      "owner": "materials",
      "executor": "agent",
      "tool": "kmos",
      "inputs": ["shortlisted_candidates", "lattice", "neighbor_rules", "diffusion_events", "coverage_states"],
      "outputs": ["spatial_rate_map", "diffusion_effects", "neighbor_effects", "finite_lattice_uncertainty"],
      "risk": "medium",
      "cost": "cpu",
      "optional": true,
      "skip_when": "candidate_count_or_spatial_question_below_threshold",
      "summary": "Apply kmos only to a small shortlisted set when diffusion, neighboring sites, or spatial correlations can change the mean-field decision."
    },
    {
      "id": "dynamics.run.uma",
      "owner": "materials",
      "executor": "mcp",
      "tool": "run_uma_surface_md",
      "inputs": ["standardized_adsorbed_path", "output_dir", "supercell", "ensemble", "temperature_k", "timestep_fs", "duration", "seeds"],
      "outputs": ["md_manifest", "trajectories", "thermo_tables", "final_structures", "representative_frames", "quality_gates"],
      "risk": "medium",
      "cost": "gpu",
      "parallelizable": true,
      "summary": "Run ASE molecular dynamics with the UMA potential on a standardized adsorbed slab after an in-plane 2x2x1 expansion."
    },
    {
      "id": "property.compute.vasp",
      "owner": "compute",
      "executor": "aicc",
      "tool": "vasp",
      "inputs": ["DFTRunSpec", "model_audit", "cost_audit", "approval"],
      "outputs": ["validated_dft_results", "provenance", "postprocessing"],
      "risk": "high",
      "cost": "expensive",
      "parallelizable": false,
      "summary": "Prepare, submit, parse, and validate final VASP evidence only after scope, cost, and human approval gates."
    },
    {
      "id": "experiment.plan",
      "owner": "experiment",
      "executor": "agent",
      "tool": "experiment_protocol",
      "inputs": ["candidate", "computed_evidence", "controls", "safety_constraints"],
      "outputs": ["synthesis_protocol", "characterization_plan", "controls", "safety_review"],
      "risk": "high",
      "cost": "laboratory",
      "parallelizable": false,
      "summary": "Translate a computationally supported candidate into a bounded, human-reviewed synthesis and electrochemical test plan."
    },
    {
      "id": "workflow.summarize",
      "owner": "planner",
      "executor": "agent",
      "tool": "report",
      "inputs": ["upstream_artifacts", "uncertainty", "next_action"],
      "outputs": ["decision_report", "next_stage_decision"],
      "risk": "low",
      "cost": "model",
      "parallelizable": false,
      "summary": "Produce a compact evidence-linked report without upgrading proxies into experimental claims."
    }
  ]
}
