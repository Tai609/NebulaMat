      {
        "id": "char_1",
        "type": "characterization",
        "method_name": "TEM",
        "data_reported": true,
        "characterization_summary": "NiCo-PBA shows regular cubic morphology with sharper corners; NiCo@A-NiCo-PBA shows core-shell structure with single-crystal core and amorphous shell ≈25 nm thick.",
        "evidence_snippet": "TEM was employed to investigate the structure of NiCo-PBA (Figure 2a,b) and NiCo@A-NiCo-PBA (Figure 2c,d). It is observed that the PBA precursors possess regular cubic morphology, with NiCo-PBA exhibiting sharper corners compared to NiCo@A-NiCo-PBA. Moreover, the core-shell structure of NiCo@A-NiCo-PBA is clearly distinguishable. The thickness of the shell is ≈25 nm."
      },
      {
        "id": "char_2",
        "type": "characterization",
        "method_name": "FESEM",
        "data_reported": true,
        "characterization_summary": "NiCo@A-NiCo-PBA shows narrow size distribution with mean particle dimension of 311 nm.",
        "evidence_snippet": "According to the FESEM image (Figure 2e), the size distribution of NiCo@A-NiCo-PBA is narrow. ... The mean particle dimension of NiCo-PBA is 277 nm while it was increased to 311 nm after the addition of the shell."
      },
      {
        "id": "char_3",
        "type": "characterization",
        "method_name": "BET",
        "data_reported": true,
        "characterization_summary": "NiCo@A-NiCo-PBA-AA has BET surface area of 179.12 m²g⁻¹ (vs 45.33 m²g⁻¹ for parent) and pore volume of 0.0518 cm³g⁻¹ (vs 0.0283 cm³g⁻¹); type II isotherm indicates micro/mesopores.",
        "evidence_snippet": "Anodized NiCo@A-NiCo-PBA-AA has a BET surface area of 179.12 m²g⁻¹, which is much larger than that of the parent NiCo@A-NiCo-PBA (45.33 m²g⁻¹). The pore volume of the PBA after activation was raised from the 0.0283 cm³g⁻¹ for NiCo@A-NiCo-PBA to 0.0518 cm³g⁻¹ for the anodized sample."
      },
      {
        "id": "char_4",
        "type": "characterization",
        "method_name": "XRD",
        "data_reported": true,
        "characterization_summary": "NiCo@A-NiCo-PBA-AA fully transformed to hexagonal Ni(OH)₂ (JCPDS 14-0117) with decreased crystallinity indicating amorphization.",
        "evidence_snippet": "When the anodization time was increased to 10 min, the transformation was complete, the NiCo@A-NiCo-PBA was fully converted to Ni(OH)₂. In addition, the degree of crystallinity decreased with the anodization time, suggesting amorphization happens during the transformation."
      },
      {
        "id": "char_5",
        "type": "characterization",
