      {
        "id": "synth_step_1",
        "type": "synthesis",
        "name": "Computational Dataset Generation and Feature Engineering",
        "procedure": "Extraction of 16,226 data points from the Catalysis-hub database followed by compositional feature extraction using the Matminer package. Site-related features were generated through one-hot encoding (20 descriptors) and subsequently reduced using Principal Component Analysis (PCA) to 5 principal components. Pearson correlation analysis was implemented to remove highly correlated features.",
        "unit_operations": [
          {
            "id": "unit_op_1.1",
            "name": "Data Extraction",
            "method": "High-throughput calculation extraction",
            "conditions": {},
            "procedure_snippet": "Our research uses a comprehensive dataset extracted from the Catalysis-hub database... The dataset encompasses a total of 16,226 distinct data points"
          },
          {
            "id": "unit_op_1.2",
            "name": "Compositional Feature Extraction",
            "method": "Matminer-based analysis",
            "conditions": {},
            "procedure_snippet": "Compositional features were systematically extracted using the Matminer package... enabled the transformation of raw chemical composition data into a rich set of numerical descriptors"
          },
          {
            "id": "unit_op_1.3",
            "name": "Dimensionality Reduction",
            "method": "Principal Component Analysis (PCA)",
            "conditions": {
              "initial_descriptors": {
                "value": 20,
                "unit": "count"
              },
              "final_components": {
                "value": 5,
                "unit": "count"
              }
            },
            "procedure_snippet": "applied Principal Component Analysis (PCA) to reduce dimensionality... effectively reduced the 20 original site features into a more manageable set of 5 principal components"
          },
          {
            "id": "unit_op_1.4",
            "name": "Feature Screening",
            "method": "Pearson correlation analysis",
            "conditions": {},
            "procedure_snippet": "implemented Pearson correlation analysis. This method identified and removed highly correlated features"
          }
        ],
        "method": "Materials Informatics and PCA",
        "conditions": {
          "stoichiometric_ratios": {
            "value": "0, 25, 50, 75, 100",
            "unit": "%"
          }
        },
        "source_text": "Our research uses a comprehensive dataset extracted from the Catalysis-hub database... The final feature set represented a carefully selected collection of material descriptors, totaling 80 features for the Hydrogen Evolution Reaction (HER) and 76 features for the Oxygen Evolution Reaction (OER)."
