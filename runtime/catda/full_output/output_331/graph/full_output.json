              }
            },
            "procedure_snippet": "MNT/PVA composite nanofibrous membrane was fabricated using the spinning solution via electrospinning process under optimal conditions"
          },
          {
            "id": "unit_op_3.3",
            "name": "Crosslinking heat treatment",
