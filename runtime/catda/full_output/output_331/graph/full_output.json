      {
        "id": "synth_step_1",
        "type": "synthesis",
        "name": "APTES modification of nano-TiO2",
        "procedure": "First, 1g of nano-TiO2 was dispersed in 100mL of a mixture of anhydrous ethanol and deionized water (9:1 v/v), and then sonicated for 30min to ensure homogeneous dispersion of the nanoparticles. Subsequently, 2g of APTES was added into the stirring suspension, and the mixture was heated to 70°C. Next, its pH value was adjusted to ≈6 using 2M HCl solution. After reacting at 70°C for 6h, the mixture was centrifugated at 10,000rpm and washed using anhydrous ethanol to remove any unreacted APTES, followed by dispersing in deionized water. The dispersion was finally freeze-dried for 48h to obtain modified nano-TiO2 (MNT).",
        "method": "Silane coupling modification",
        "conditions": {
          "temperature": {
            "value": 70,
            "unit": "°C"
          },
          "reaction_time": {
            "value": 6,
            "unit": "h"
          },
          "pH": {
            "value": 6,
            "unit": "pH units"
          },
          "sonication_time": {
            "value": 30,
            "unit": "min"
          },
          "centrifugation_speed": {
            "value": 10000,
            "unit": "rpm"
          },
          "freeze_drying_time": {
            "value": 48,
            "unit": "h"
          }
        },
        "source_text": "Modification of Nano-TiO2 with APTES: First, 1g of nano-TiO2 was dispersed in 100mL... freeze-dried for 48h to obtain modified nano-TiO2 (MNT)."
      },
      {
        "id": "synth_step_2",
        "type": "synthesis",
        "name": "PVA spinning solution preparation",
        "procedure": "1.0g of PVA was added into 9mL of deionized water and mechanically stirred at 95°C for 5h to obtain a homogeneous solution. 1.5g of WM44-L70G was added, and the suspension was magnetically stirred at room temperature for 10min to obtain a spinning solution.",
        "method": "Polymer dissolution",
        "conditions": {
          "dissolution_temperature": {
            "value": 95,
            "unit": "°C"
          },
          "dissolution_time": {
            "value": 5,
            "unit": "h"
          },
          "mixing_time": {
            "value": 10,
            "unit": "min"
          }
        },
        "source_text": "1.0g of PVA was added into 9mL of deionized water and mechanically stirred at 95°C for 5h... magnetically stirred at room temperature for 10min to obtain a spinning solution."
      },
      {
        "id": "synth_step_3",
        "type": "synthesis",
        "name": "MNT/PVA electrospinning",
        "procedure": "MNT at different weight fractions (0.5, 1.0, 1.5, and 2.0wt%) was then added [to PVA solution], and the pH value of the mixture was adjusted to 2 using concentrated HCl, followed by sonicating it for 30min to acquire uniform dispersion of the nanoparticles as a filler. Finally, MNT/PVA composite nanofibrous membrane was fabricated using the spinning solution via electrospinning process under optimal conditions, that is, a spinning voltage of 22kV, a working distance of 15cm, and a feed rate of 0.6mL h^-1. The obtained membrane was heat-treated in a vacuum drying oven at 90°C for 0.5h for use as a nanofibrous separator for LIB.",
        "unit_operations": [
          {
            "id": "unit_op_3.1",
            "name": "Nanoparticle dispersion",
            "method": "Ultrasonic dispersion",
            "conditions": {
              "pH": {
