        "id": "synth_step_1",
        "type": "synthesis",
        "name": "CVD nitrogen-doped carbon nanoprisms on CC",
        "procedure": "Chen and co-workers presented a chemical vapor deposition (CVD) strategy for the preparation of nitrogen-doped hollow hexagonal carbon nanoprism arrays on CC. Hexagonal nanoprism structured ZnO is applied as a template, which can be well duplicated via an ultrathin nitrogen-doped carbon layer through in situ carbon deposition.",
        "method": "Chemical Vapor Deposition",
        "conditions": {},
        "source_text": "Chen and co-workers presented a chemical vapor deposition (CVD) strategy for the preparation of nitrogen-doped hollow hexagonal carbon nanoprism arrays on CC...",
        "unit_operations": [
          {
            "id": "unit_op_1.1",
            "name": "Template preparation",
            "method": "ZnO template formation",
            "conditions": {},
            "procedure_snippet": "Hexagonal nanoprism structured ZnO is applied as a template"
          },
          {
            "id": "unit_op_1.2",
            "name": "CVD deposition",
            "method": "Chemical Vapor Deposition",
            "conditions": {},
            "procedure_snippet": "duplicated via an ultrathin nitrogen-doped carbon layer through in situ carbon deposition"
          }
        ]
      },
      {
        "id": "synth_step_2",
        "type": "synthesis",
        "name": "Self-sacrificing template and in situ vapor-phase polymerization",
        "procedure": "Hu and co-workers fabricated 3D interconnected hierarchical tectorum-like α-Fe2O3/polypyrrole nanoarrays (T-Fe2O3/PPy NAs, Figure 3d), which grow on CC via a simple self-sacrificing template and in situ vapor-phase polymerization approach under mild conditions. The optimized PPY shell thickness is ≈3 nm (Figure 3e-g).",
        "method": "Vapor-phase polymerization",
        "conditions": {},
        "source_text": "Hu and co-workers fabricated 3D interconnected hierarchical tectorum-like α-Fe2O3/polypyrrole nanoarrays (T-Fe2O3/PPy NAs, Figure 3d)...",
        "unit_operations": [
          {
            "id": "unit_op_2.1",
            "name": "Self-sacrificing template",
            "method": "Template formation",
            "conditions": {},
            "procedure_snippet": "simple self-sacrificing template"
          },
          {
            "id": "unit_op_2.2",
            "name": "In situ vapor-phase polymerization",
            "method": "Vapor-phase polymerization",
            "conditions": {},
            "procedure_snippet": "in situ vapor-phase polymerization approach under mild conditions. The optimized PPY shell thickness is ≈3 nm"
          }
        ]
      },
