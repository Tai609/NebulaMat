      {
        "id": "synth_step_1",
        "type": "synthesis",
        "name": "QMMD water/Pt(100) interface simulation",
        "procedure": "Carried out Quantum Mechanics Molecular Dynamics (QMMD) with explicit considerations of solvent and applied voltage (U) to in situ simulate water/Pt(100) interface in the condition of under-potential adsorption of hydrogen (H_UPD). Considered U between +0.29 and -0.46 V to cover the range of experimental condition from pH 0.2 to 12.8 at U = +0.3 V (RHE). Used explicit model (~6 water layers), explicit + Na⁺ model (~6 water layers +1 Na), and explicit + implicit model (~3 water layers + implicit solvation model). The work function of water/Pt(100) predicted from QM-MD is -5.06 eV, which corresponding to U = 0.62 V (taking reference SHE as -4.44 eV). Extra electrons were introduced to simulate more negative U by either explicitly introducing sodium (Na) or combining an implicit solvation model on top of explicit water leading to the hybrid scheme.",
        "unit_operations": [
          {
            "id": "unit_op_1.1",
            "name": "Explicit solvent simulation",
            "method": "Explicit solvent QMMD",
            "conditions": {
              "water_layers": {
                "value": 6,
                "unit": "layers"
              }
            },
            "procedure_snippet": "Explicit model (~6 water layers)"
          },
          {
            "id": "unit_op_1.2",
            "name": "Na+ explicit electrolyte simulation",
            "method": "Explicit + Na⁺ QMMD",
            "conditions": {
              "water_layers": {
                "value": 6,
                "unit": "layers"
              },
              "Na": {
                "value": 1,
                "unit": "ion"
              }
            },
            "procedure_snippet": "Explicit + Na⁺ model (~6 water layers +1 Na)"
          },
          {
            "id": "unit_op_1.3",
            "name": "Hybrid explicit/implicit simulation",
            "method": "Hybrid solvation QMMD",
            "conditions": {
              "water_layers": {
                "value": 3,
                "unit": "layers"
              },
              "work_function_values": {
                "value": "4.73, 4.34, 4.11, 3.98",
                "unit": "eV"
              },
              "extra_charges": {
                "value": "0.97, 1.94, 3.06, 3.48",
                "unit": "e-"
              },
              "potentials": {
                "value": "+0.29, -0.10, -0.33, -0.46",
                "unit": "V"
              }
            },
            "procedure_snippet": "Explicit + Implicit model (~3 water layers + Implicit solvation model). For example, we can simulate the work function of 4.73, 4.34, 4.11 and 3.98 eV by introducing extra charges of 0.97 e⁻, 1.94 e⁻, 3.06 e⁻ and 3.48 e⁻, resulting in U = +0.29, -0.10, -0.33 and -0.46 V."
          }
        ],
        "method": "Quantum Mechanics Molecular Dynamics",
        "conditions": {
          "potential_range": {
            "value": "+0.29 to -0.46",
            "unit": "V vs SHE"
          },
          "pH_range": {
            "value": "0.2 to 12.8",
            "unit": "pH"
          },
          "RHE_reference": {
            "value": 0.3,
            "unit": "V"
          },
          "work_function": {
            "value": -5.06,
            "unit": "eV"
          },
          "SHE_reference": {
            "value": -4.44,
            "unit": "eV"
          },
          "Pt-O_first_peak": {
            "value": 2.15,
            "unit": "Å"
          }
        },
        "source_text": "we carried out QMMD with explicit solvent to directly simulate water/Pt(100) interface... Thus, with both the explicit and hybrid schemes, we can carry out QMMD simulations and perform in situ analysis at given U s of H_UPD from pH 0.2 to 12.8."
      },
      {
        "id": "synth_step_2",
        "type": "synthesis",
        "name": "Widom insertion HBE* calculation",
        "procedure": "Employed Widom insertion (WI) method to calculate the free energies of hydrogen binding on the water/Pt(100) interface at U = +0.29, -0.01, -0.10, -0.33 and -0.46 V. The obtained HBE* at different U's converted back to pH of 0.2, 5.2, 6.7, 10.7 and 12.8 at U = 0.3 V (RHE). Predicted 0.13 eV increase in hydrogen binding from pH = 0.2 to pH = 12.8 with a slope of 10 meV/pH.",
        "unit_operations": [
          {
            "id": "unit_op_2.1",
            "name": "Widom Particle Insertion",
            "method": "Free energy calculation",
            "conditions": {
              "potentials": {
                "value": "+0.29, -0.01, -0.10, -0.33, -0.46",
                "unit": "V"
              },
              "corresponding_pH": {
                "value": "0.2, 5.2, 6.7, 10.7, 12.8",
                "unit": "pH"
              }
            },
            "procedure_snippet": "employed Widom insertion (WI) method to calculate the free energies of hydrogen binding on the interface at U = +0.29, -0.01, -0.10, -0.33 and -0.46 V"
          }
        ],
        "method": "Widom insertion method",
        "conditions": {
          "potentials": {
            "value": "+0.29, -0.01, -0.10, -0.33, -0.46",
            "unit": "V"
          },
          "pH_corresponding": {
            "value": "0.2, 5.2, 6.7, 10.7, 12.8",
            "unit": "pH"
          },
          "RHE_reference": {
            "value": 0.3,
            "unit": "V"
          },
          "HBE_increase": {
            "value": 0.13,
            "unit": "eV"
          },
          "HBE_slope": {
            "value": 10,
            "unit": "meV/pH"
          }
        },
        "source_text": "To predict the HBE*, we employed Widom insertion (WI) method... The slope predicted from QMMD is 10 meV/pH"
      },
