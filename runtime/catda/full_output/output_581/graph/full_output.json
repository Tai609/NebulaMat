        "results_json": {
          "open_circuit_potential_Eoc": {
            "value": 1.3,
            "unit": "eV"
          },
          "short_circuit_current_density_Jsc": {
            "value": 1.72,
            "unit": "mA/cm²"
          },
          "fill_factor": {
            "value": 0.41,
            "unit": "dimensionless"
          },
          "efficiency": {
            "value": 0.9,
            "unit": "%"
          }
        },
        "source_text": "Our best sample produced an E_oc , which corresponds to V_oc in a solid state device, of 1.3 eV and a J_sc of 1.72 mA cm^{-2} , a fill factor of 0.41, and an efficiency of 0.9%. Our measured E_oc , 1.3 eV, suggests a lack of deep level defects which was supported by photoluminescence data."
      },
      {
        "id": "test_2",
        "type": "testing",
        "catalyst_id": "chem_ZnSnN2",
        "description": "current density-voltage characteristics of ZnSnN2/SnO heterojunction solar cells",
        "conditions_json": {
          "device_type": {
            "value": "ZnSnN2/SnO heterojunction",
            "unit": "solar cell"
