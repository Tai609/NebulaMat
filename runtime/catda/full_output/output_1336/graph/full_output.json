          },
          "counter_electrode": {
            "value": "Pt wire",
            "unit": "electrode"
          }
        },
        "results_json": {
          "enhancement_factor_range": {
            "value": "up to 2.66",
            "unit": "×10^4"
          },
          "characteristic_R6G_bands": {
            "value": "612, 773, 1360, 1650",
            "unit": "cm^-1"
          },
          "linear_correlation_R2": {
