        "type": "testing",
        "catalyst_id": "chem_tungsten_oxide",
        "description": "SERS measurement of R6G (10^-4 M) on Al-intercalated tungsten oxide films at different coloration degrees (-0.1 to -0.6 V)",
        "conditions_json": {
          "reaction_type": {
            "value": "SERS",
