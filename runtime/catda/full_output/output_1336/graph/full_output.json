            "value": 20,
            "unit": "min"
          },
          "drying_temperature": {
            "value": 60,
            "unit": "°C"
          }
        },
        "source_text": "Film fabrication. To fabricate electrochromic film substrates for SERS tests, slabs of FTO-coated glass... before drying at 60 °C."
      },
      {
        "id": "synth_step_2",
        "type": "synthesis",
        "name": "Reactive DC magnetron sputtering",
        "procedure": "The tungsten oxide thin films on FTO glass were prepared by reactive DC magnetron sputtering at room temperature. The background pressure of the sputtering cavity was evacuated to 8 × 10^-4 Pa before deposition. Then, the DC power of the tungsten target (>99.9%) was kept at 200 W for 10 min, with the ratio of Ar:O2 fixed as 80:20 sccm and the pressure maintained at 0.2 Pa during sputtering.",
        "unit_operations": [
          {
            "id": "unit_op_2.1",
            "name": "Chamber evacuation",
            "method": "Vacuum pumping",
            "conditions": {
              "background_pressure": {
                "value": "8×10^-4",
                "unit": "Pa"
              }
            },
            "procedure_snippet": "The background pressure of the sputtering cavity was evacuated to 8 × 10^-4 Pa before deposition."
          },
